# Sin scripts de instalación: ningún paquete corre código al instalarse (así roban tokens los paquetes comprometidos).
# Electron baja su binario con `node node_modules/electron/install.js` (lo hace a mano quien prueba) y electron-builder baja
# el suyo al empaquetar: ninguno necesita scripts.
ignore-scripts=true
save-exact=true
