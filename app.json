{
 "nombre": "Esquema",
 "id": "esquema",
 "version": "0.4.0",
 "datos": "sistema",
 "plataformas": [
  "mac",
  "windows",
  "linux"
 ],
 "icono": "docs/favicon.svg",
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "tema": [
   "sistema",
   "claro",
   "oscuro",
   "vidrio"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "carpeta": {
   "tipo": "texto",
   "interfaz": false
  }
 },
 "catalogo": {
  "repo": "esquema-app/esquema-catalogo",
  "rama": "main",
  "tipos": {
   "plantillas": {
    "validador": "plantilla_formato",
    "indice": "index.json",
    "singular": "plantilla",
    "origen": false
   }
  }
 },
 "acciones": {
  "proyecto": {
   "script": "proyecto.py",
   "args": [
    "$orden"
   ],
   "entrada": "archivo",
   "datos": {
    "orden": {
     "tipo": "enum",
     "valores": [
      "abrir",
      "leer",
      "preparar",
      "generar",
      "guardar",
      "version",
      "versiones",
      "ver",
      "restaurar",
      "vincular",
      "mover",
      "destinos",
      "pasar",
      "codigo",
      "codigo_leer",
      "codigo_guardar",
      "arbol",
      "documentar",
      "trabajo",
      "detener",
      "quitar",
      "detectar",
      "agregar",
      "crear",
      "responder",
      "continuar",
      "borrar",
      "recuperar",
      "historia_estado",
      "historia_cierre",
      "estudiar",
      "incongruencias",
      "wiki_preparar",
      "wiki_publicar"
     ]
    },
    "*": "pasar"
   },
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "proyectoRespuesta",
   "eco": [
    "orden"
   ],
   "progreso": "proyectoProgreso",
   "limite": {
    "segun": "orden",
    "valores": {
     "documentar": "trabajo",
     "agregar": "trabajo",
     "responder": "trabajo",
     "continuar": "trabajo",
     "historia_cierre": "trabajo",
     "estudiar": "trabajo",
     "incongruencias": "trabajo",
     "generar": "trabajo",
     "crear": 600,
     "wiki_preparar": 600,
     "wiki_publicar": 600
    },
    "otro": 300
   },
   "scriptDeLaApp": true
  },
  "dibujar": {
   "script": "asistente.py",
   "args": [
    "dibujar"
   ],
   "entrada": "archivo",
   "datos": {
    "pedido": {
     "tipo": "texto",
     "max": 3000,
     "recortar": true
    },
    "tipo": {
     "tipo": "enum",
     "valores": [
      "auto",
      "flujo",
      "secuencia",
      "arquitectura"
     ]
    },
    "actual": {
     "tipo": "texto",
     "max": 60000,
     "recortar": true
    }
   },
   "inyectar": {
    "idioma": "idiomaUI"
   },
   "responde": "dibujoListo",
   "limite": 900,
   "scriptDeLaApp": true
  },
  "crearReadme": {
   "script": "asistente.py",
   "args": [
    "readme"
   ],
   "entrada": "archivo",
   "datos": {
    "descripcion": {
     "tipo": "texto",
     "max": 4000,
     "recortar": true
    },
    "estructura": {
     "tipo": "bool"
    },
    "anterior": {
     "tipo": "texto",
     "max": 200000,
     "recortar": true
    },
    "pedido": {
     "tipo": "texto",
     "max": 2000,
     "recortar": true
    }
   },
   "inyectar": {
    "carpeta": "carpetaActual",
    "idioma": "idiomaUI"
   },
   "responde": "readmeListo",
   "limite": 900,
   "scriptDeLaApp": true
  },
  "estructura": {
   "script": "carpeta.py",
   "args": [
    "estructura"
   ],
   "entrada": "archivo",
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "estructuraLista",
   "limite": 60,
   "scriptDeLaApp": true
  },
  "abrirArchivo": {
   "script": "carpeta.py",
   "args": [
    "leer"
   ],
   "entrada": "archivo",
   "datos": {
    "ruta": {
     "tipo": "rutaRelativa",
     "extensiones": [
      ".md",
      ".mmd"
     ],
     "requerido": true
    }
   },
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "archivoAbierto",
   "eco": [
    "ruta"
   ],
   "vigilar": "lee",
   "limite": 30,
   "scriptDeLaApp": true
  },
  "guardarArchivo": {
   "script": "carpeta.py",
   "args": [
    "guardar"
   ],
   "entrada": "archivo",
   "datos": {
    "ruta": {
     "tipo": "rutaRelativa",
     "extensiones": [
      ".md",
      ".mmd"
     ],
     "requerido": true
    },
    "texto": {
     "tipo": "texto",
     "max": 2097152,
     "requerido": true
    },
    "nuevo": {
     "tipo": "bool"
    }
   },
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "archivoGuardado",
   "eco": [
    "ruta"
   ],
   "cola": "escritura",
   "vigilar": "escribe",
   "maximo": 16777216,
   "limite": 30,
   "scriptDeLaApp": true
  }
 },
 "empaquetado": {
  "descripcion": "Diagramas y documentación, con tu propia IA",
  "categoria": "public.app-category.developer-tools",
  "linux_categoria": "Development",
  "carpetas": [
   "plantillas",
   "tipos"
  ],
  "permisos": [],
  "ocupada": [],
  "deb": true
 }
}
