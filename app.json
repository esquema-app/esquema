{
 "nombre": "Esquema",
 "id": "esquema",
 "datos": "sistema",
 "plataformas": [
  "mac",
  "windows",
  "linux"
 ],
 "icono": "docs/favicon.svg",
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "tema": [
   "sistema",
   "claro",
   "oscuro"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "carpeta": {
   "tipo": "texto",
   "interfaz": false
  }
 },
 "catalogo": {
  "repo": "esquema-app/esquema-catalogo",
  "rama": "main",
  "tipos": {
   "plantillas": {
    "validador": "plantilla_formato",
    "indice": "index.json",
    "singular": "plantilla",
    "origen": false
   }
  }
 },
 "acciones": {
  "proyecto": {
   "script": "proyecto.py",
   "args": [
    "$orden"
   ],
   "entrada": "archivo",
   "datos": {
    "orden": {
     "tipo": "enum",
     "valores": [
      "abrir",
      "leer",
      "preparar",
      "generar",
      "guardar",
      "version",
      "versiones",
      "ver",
      "restaurar",
      "vincular",
      "mover",
      "destinos",
      "pasar",
      "codigo",
      "codigo_leer",
      "codigo_guardar",
      "arbol",
      "documentar",
      "trabajo",
      "detener",
      "quitar",
      "detectar",
      "agregar",
      "crear",
      "responder",
      "continuar",
      "borrar",
      "recuperar",
      "historia_estado",
      "historia_cierre",
      "estudiar",
      "incongruencias",
      "wiki_preparar",
      "wiki_publicar"
     ]
    },
    "*": "pasar"
   },
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "proyectoRespuesta",
   "eco": [
    "orden"
   ],
   "progreso": "proyectoProgreso",
   "limite": 3600,
   "scriptDeLaApp": true
  },
  "dibujar": {
   "script": "asistente.py",
   "args": [
    "dibujar"
   ],
   "entrada": "archivo",
   "datos": {
    "pedido": {
     "tipo": "texto",
     "max": 3000,
     "recortar": true
    },
    "tipo": {
     "tipo": "enum",
     "valores": [
      "auto",
      "flujo",
      "secuencia",
      "arquitectura"
     ]
    },
    "actual": {
     "tipo": "texto",
     "max": 60000,
     "recortar": true
    }
   },
   "inyectar": {
    "idioma": "idiomaUI"
   },
   "responde": "dibujoListo",
   "limite": 900,
   "scriptDeLaApp": true
  },
  "crearReadme": {
   "script": "asistente.py",
   "args": [
    "readme"
   ],
   "entrada": "archivo",
   "datos": {
    "descripcion": {
     "tipo": "texto",
     "max": 4000,
     "recortar": true
    },
    "estructura": {
     "tipo": "bool"
    },
    "anterior": {
     "tipo": "texto",
     "max": 200000,
     "recortar": true
    },
    "pedido": {
     "tipo": "texto",
     "max": 2000,
     "recortar": true
    }
   },
   "inyectar": {
    "carpeta": "carpetaActual",
    "idioma": "idiomaUI"
   },
   "responde": "readmeListo",
   "limite": 900,
   "scriptDeLaApp": true
  },
  "estructura": {
   "script": "carpeta.py",
   "args": [
    "estructura"
   ],
   "entrada": "archivo",
   "inyectar": {
    "carpeta": "carpetaActual"
   },
   "responde": "estructuraLista",
   "limite": 60,
   "scriptDeLaApp": true
  }
 }
}
